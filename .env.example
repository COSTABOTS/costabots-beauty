# Identidad obligatoria de esta aplicación.
VITE_PRODUCT_ID=costabots-beauty
VITE_APP_ENV=local

# Sustituir por credenciales exclusivas del futuro proyecto Supabase Beauty.
VITE_SUPABASE_URL=https://beauty-project-placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=beauty-anon-key-placeholder
VITE_BEAUTY_SUPABASE_PROJECT_REF=beauty-project-placeholder

# API pública futura de Beauty. Vacía mantiene la integración deshabilitada.
VITE_BEAUTY_PUBLIC_API_BASE_URL=

# Integraciones heredadas: deben permanecer deshabilitadas por defecto.
VITE_ENABLE_LEGACY_SHEETS=false
VITE_ENABLE_LEGACY_WEBHOOKS=false
VITE_USE_MANAGER_API=false
VITE_USE_EDGE_TABLES=false
