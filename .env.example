# Identidad local de COSTABOTS Beauty.
VITE_PRODUCT_ID=costabots-beauty
VITE_APP_ENV=local

# Configuración exclusiva del proyecto Supabase COSTABOTS BEAUTY.
# Usa la Publishable key; nunca una secret key ni service_role.
VITE_SUPABASE_URL=https://replace-with-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_EXPECTED_SUPABASE_PROJECT_REF=replace-with-project-ref

# El prototipo continúa usando exclusivamente datos locales.
VITE_BEAUTY_DATA_MODE=mock

# API pública futura. Vacía mantiene la integración deshabilitada.
VITE_BEAUTY_PUBLIC_API_BASE_URL=

# Integraciones heredadas: deben permanecer deshabilitadas por defecto.
VITE_ENABLE_LEGACY_SHEETS=false
VITE_ENABLE_LEGACY_WEBHOOKS=false
VITE_USE_MANAGER_API=false
VITE_USE_EDGE_TABLES=false
